# Supabase (EU / Frankfurt project). Leave empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Apify (actors that need no LinkedIn login or cookies)
APIFY_TOKEN=
APIFY_PROFILE_ACTOR=
APIFY_POSTS_ACTOR=
APIFY_SEARCH_ACTOR=

# Demo-mode storage shared across Vercel functions (Upstash Redis via Vercel Storage). Not needed locally.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Demo mode: every external call (Apify, Anthropic) uses fixtures, data lives in .data/demo-db.json
DEMO_MODE=true

# Your Supabase user id; unlocks /admin/pilot
ADMIN_USER_ID=

# Public base URL (used for QR codes and signed export links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret for Vercel Cron (/api/cron/cleanup) and for signing export links
CRON_SECRET=change-me
